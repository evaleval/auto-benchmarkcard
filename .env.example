# Copy this file to .env and fill in the values you need. Only the engine you
# select and the services you use must be configured.

# ---------------------------------------------------------------------------
# Composer model (writes and repairs the card)
# ---------------------------------------------------------------------------
# Engine for all model calls: hf | ollama | vllm | wml | rits | openrouter
LLM_ENGINE_TYPE=hf

# Hugging Face inference (the default engine)
HF_TOKEN=<your-huggingface-token>
HF_COMPOSER_MODEL=deepseek-ai/DeepSeek-V4-Flash
# HF_API_URL=https://router.huggingface.co/v1
# HF_ORG=<org-to-bill>

# Route only the composer calls to another engine while everything else keeps
# LLM_ENGINE_TYPE. The model name is still read from <LLM_ENGINE_TYPE>_COMPOSER_MODEL.
# COMPOSER_ENGINE_TYPE=openrouter
# OPENROUTER_API_KEY=<your-openrouter-api-key>
# OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash      # checkpoint id on OpenRouter
# OPENROUTER_PROVIDER_ORDER=<provider>                 # pin the serving provider(s)
# OPENROUTER_QUANTIZATION=fp8                          # recorded in the usage log
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local inference with Ollama instead of Hugging Face
# LLM_ENGINE_TYPE=ollama
# OLLAMA_API_URL=http://localhost:11434
# OLLAMA_COMPOSER_MODEL=gemma3:27b

# Other engines supported by ai-atlas-nexus (see its documentation for the
# remaining variables)
# VLLM_API_URL=<openai-compatible-endpoint>
# WML_API_URL=<watsonx-endpoint>
# RITS_API_URL=<rits-endpoint>
# RITS_API_KEY=<rits-api-key>

# ---------------------------------------------------------------------------
# Factuality check (FactReasoner)
# ---------------------------------------------------------------------------
# Needs the Merlin binary and a model endpoint that returns token logprobs.
# MERLIN_BIN=external/merlin/bin/merlin
FACTREASONER_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Engine for the factuality model when it differs from LLM_ENGINE_TYPE
# (hf | rits | any OpenAI-compatible endpoint configured below).
# FACTREASONER_ENGINE_TYPE=hf
# FACTREASONER_API_BASE=<openai-compatible-endpoint>
# FACTREASONER_API_KEY=<api-key>
# FACTREASONER_PROVIDER=<provider>                     # OpenRouter provider pin

# ---------------------------------------------------------------------------
# Source resolution (optional, raises rate limits and recall)
# ---------------------------------------------------------------------------
# OPENALEX_API_KEY=<your-openalex-api-key>
# OPENALEX_MAILTO=your-public-contact@example.org
# S2_API_KEY=<your-semantic-scholar-api-key>
# GITHUB_TOKEN=<your-github-token>

# ---------------------------------------------------------------------------
# Pipeline switches
# ---------------------------------------------------------------------------
# Verify the bound Hugging Face dataset and the bound paper before trusting them.
# HF_VERIFICATION_ENABLED=true
# PAPER_VERIFICATION_ENABLED=true
# Replay a previous run's fetched sources instead of fetching again.
# SOURCE_BUNDLE_DIR=<path-to-source-bundle>
