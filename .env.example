# Copy this file to .env and fill in your values.
#
# Configure only the providers and credentials required by your run.

LLM_ENGINE_TYPE=hf

HF_TOKEN=<your-huggingface-token>
# HF_ORG=<your-org>                          # optional: org billing

HF_COMPOSER_MODEL=deepseek-ai/DeepSeek-V4-Flash
FACTREASONER_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional source-resolution credentials.
# OPENALEX_API_KEY=<your-openalex-api-key>
# OPENALEX_MAILTO=your-public-contact@example.org
# S2_API_KEY=<your-semantic-scholar-api-key>
# GITHUB_TOKEN=<your-github-token>

# Optional hosted-model backends used by the evaluation scripts.
# OPENROUTER_API_KEY=<your-openrouter-api-key>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# For local inference with Ollama instead:
# LLM_ENGINE_TYPE=ollama
# OLLAMA_API_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:27b
